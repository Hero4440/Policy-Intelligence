# ============================================
# REQUIRED - Add these to your .env.local for local development
# ============================================

# Google Gemini API Key (get from console.cloud.google.com)
GEMINI_KEY_API=your_gemini_api_key_here

# ============================================
# OPTIONAL - Google Cloud Configuration
# ============================================

# Google Cloud Project ID (defaults to policy-intelligence-493802)
GEMINI_VERTEX_PROJECT_ID=policy-intelligence-493802

# Google Cloud Region (defaults to us-central1)
GEMINI_VERTEX_LOCATION=us-central1

# ============================================
# OPTIONAL - Server Configuration
# ============================================

# Environment: development (local) or production (Vercel/Railway)
# Defaults to 'development' - only set to 'production' on servers
NODE_ENV=development

# Server port (defaults to 3000)
PORT=3000

# Override default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ============================================
# INSTRUCTIONS FOR DIFFERENT ENVIRONMENTS
# ============================================

# LOCAL DEVELOPMENT:
# 1. Copy this file: cp .env.example .env.local
# 2. Edit .env.local and add GEMINI_KEY_API
# 3. Run: npm run server:dev
# Note: .env.local is gitignored and only on your machine

# VERCEL DEPLOYMENT:
# 1. Go to Vercel Dashboard > Project > Settings > Environment Variables
# 2. Add GEMINI_KEY_API and other variables
# 3. Push to main branch - auto-deploys

# RAILWAY DEPLOYMENT:
# 1. Go to Railway Dashboard > Project > Settings > Variables
# 2. Add GEMINI_KEY_API and other variables
# 3. Push to main branch - auto-deploys

# DOCKER/SELF-HOSTED:
# 1. Build: docker build -t policypilot .
# 2. Run: docker run -p 3000:3000 -e GEMINI_KEY_API=your_key policypilot
