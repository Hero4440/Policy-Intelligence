{
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "dist",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://policy-intelligence-production.up.railway.app/api/$1"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "https://policy-intelligence-production.up.railway.app/mcp/$1"
    },
    {
      "source": "/health",
      "destination": "https://policy-intelligence-production.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}
