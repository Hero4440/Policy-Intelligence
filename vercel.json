{
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "dist",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "${RAILWAY_BACKEND_URL}/api/$1"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "${RAILWAY_BACKEND_URL}/mcp/$1"
    },
    {
      "source": "/health",
      "destination": "${RAILWAY_BACKEND_URL}/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}
