{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "node --loader tsx/esm src/server/index.ts",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5,
    "memoryMB": 512,
    "numReplicas": 1
  },
  "environment": {
    "NODE_ENV": "production",
    "PORT": "3000"
  }
}
